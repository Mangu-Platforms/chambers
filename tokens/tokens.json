{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Chambers design tokens — Apple calm × Instagram pulse, one vermilion hairline. Extracted 2026-08-25 from design/migration-mockups.",
  "meta": {
    "name": "chambers",
    "version": "1.0.0",
    "owner": "Mangu Platforms",
    "lane": "A — design system + instant HTML drops",
    "not": "A Figma competitor. Resume SaaS lives in chambers-ai."
  },
  "color": {
    "vermilion": {
      "500": { "$type": "color", "$value": "#FF4D00", "$description": "Actions, accents, selected marks" },
      "600": { "$type": "color", "$value": "#D93F00", "$description": "Ember — orange text on white (AA)" }
    },
    "ink": { "$type": "color", "$value": "#1D1D1F", "$description": "Primary type, dark bands" },
    "night": { "$type": "color", "$value": "#0B0B0F", "$description": "Studio and ACX bands" },
    "fog": { "$type": "color", "$value": "#F5F5F7", "$description": "Quiet Apple sections" },
    "cream": { "$type": "color", "$value": "#FFFAF6", "$description": "Warm paper fills" },
    "paper": { "$type": "color", "$value": "#FFFFFF" },
    "muted": { "$type": "color", "$value": "#6E6E73" },
    "line": { "$type": "color", "$value": "rgba(255,77,0,0.32)", "$description": "Hairline on every card, chip, frame, field" },
    "line-strong": { "$type": "color", "$value": "rgba(255,77,0,0.72)", "$description": "Selected voice / focus ring" },
    "story": {
      "amber": { "$type": "color", "$value": "#FFC24B" },
      "ember": { "$type": "color", "$value": "#FF5A1F" },
      "blush": { "$type": "color", "$value": "#E9308F" },
      "iris": { "$type": "color", "$value": "#8A3FFC" }
    }
  },
  "gradient": {
    "story": {
      "$type": "other",
      "$value": "linear-gradient(135deg, #FFC24B 0%, #FF5A1F 38%, #E9308F 72%, #8A3FFC 100%)",
      "$description": "Rings, steppers, moments of delight only"
    }
  },
  "border": {
    "hairline": {
      "$type": "border",
      "$value": { "width": "1px", "style": "solid", "color": "{color.line}" },
      "$description": "The Chambers signature. Never 0. Never 2px on idle surfaces."
    },
    "selected": {
      "$type": "border",
      "$value": { "width": "1.5px", "style": "solid", "color": "{color.vermilion.500}" },
      "$description": "Only selected voice / active page uses 1.5px"
    }
  },
  "dimension": {
    "hairline": { "$type": "dimension", "$value": "1px" },
    "hairline-selected": { "$type": "dimension", "$value": "1.5px" },
    "radius": {
      "sm": { "$type": "dimension", "$value": "8px" },
      "md": { "$type": "dimension", "$value": "14px" },
      "lg": { "$type": "dimension", "$value": "22px" },
      "pill": { "$type": "dimension", "$value": "999px" }
    },
    "space": {
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "5": { "$type": "dimension", "$value": "24px" },
      "6": { "$type": "dimension", "$value": "32px" },
      "7": { "$type": "dimension", "$value": "48px" },
      "8": { "$type": "dimension", "$value": "64px" },
      "9": { "$type": "dimension", "$value": "96px" }
    },
    "page": {
      "max": { "$type": "dimension", "$value": "1120px" },
      "resume": { "$type": "dimension", "$value": "816px", "$description": "US Letter width at 96dpi — Enhancv-class sheet" }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["SF Pro Text", "SF Pro Display", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Helvetica Neue", "Arial", "sans-serif"]
      },
      "display": {
        "$type": "fontFamily",
        "$value": ["SF Pro Display", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["SF Mono", "ui-monospace", "Menlo", "Consolas", "monospace"]
      }
    },
    "size": {
      "caption": { "$type": "fontSize", "$value": "11px" },
      "meta": { "$type": "fontSize", "$value": "12px" },
      "body": { "$type": "fontSize", "$value": "15px" },
      "lead": { "$type": "fontSize", "$value": "17px" },
      "title": { "$type": "fontSize", "$value": "22px" },
      "display": { "$type": "fontSize", "$value": "34px" },
      "hero": { "$type": "fontSize", "$value": "56px" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 510 },
      "semibold": { "$type": "fontWeight", "$value": 590 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "tracking": {
      "display": { "$type": "other", "$value": "-0.035em" },
      "tight": { "$type": "other", "$value": "-0.02em" },
      "body": { "$type": "other", "$value": "-0.011em" }
    },
    "leading": {
      "display": { "$type": "other", "$value": 1.05 },
      "title": { "$type": "other", "$value": 1.2 },
      "body": { "$type": "other", "$value": 1.47 }
    }
  },
  "shadow": {
    "none": { "$type": "shadow", "$value": { "color": "#00000000", "offsetX": "0", "offsetY": "0", "blur": "0", "spread": "0" } },
    "soft": {
      "$type": "shadow",
      "$value": { "color": "rgba(29,29,31,0.06)", "offsetX": "0", "offsetY": "8px", "blur": "24px", "spread": "0" },
      "$description": "Apple-quiet lift. Never drop-shadow candy."
    }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "160ms" },
      "base": { "$type": "duration", "$value": "240ms" }
    },
    "easing": {
      "apple": { "$type": "cubicBezier", "$value": [0.25, 0.1, 0.25, 1] }
    }
  },
  "component": {
    "button": {
      "height": { "$type": "dimension", "$value": "44px" },
      "radius": { "$type": "dimension", "$value": "999px" }
    },
    "field": {
      "height": { "$type": "dimension", "$value": "44px" },
      "radius": { "$type": "dimension", "$value": "14px" }
    },
    "chip": {
      "height": { "$type": "dimension", "$value": "28px" },
      "radius": { "$type": "dimension", "$value": "999px" }
    }
  }
}
